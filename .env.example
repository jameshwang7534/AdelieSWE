# Local infrastructure defaults ONLY; never reuse this password in production.
# Compose reads these settings from .env or the shell; .env is ignored by Git.
POSTGRES_DB=platform_dev
POSTGRES_USER=platform_dev
POSTGRES_PASSWORD=local-development-only
# Published host ports; container ports remain 5432 and 6379.
POSTGRES_PORT=5432
REDIS_PORT=6379

# Application connection settings, consumed by Settings and readiness checks.
# Host processes use 127.0.0.1. Future Compose containers use postgres / redis.
# Keep URLs in sync with the credentials and host ports above; URL-encode
# special characters in usernames/passwords when constructing DATABASE_URL.
DATABASE_URL=postgresql+psycopg://platform_dev:local-development-only@127.0.0.1:5432/platform_dev
REDIS_URL=redis://127.0.0.1:6379/0
# Celery broker/results use separate Redis DBs; both are required for /tasks.
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# Application settings. Empty optional values use defaults or None.
APP_ENV=development
APP_NAME=AI Software Engineering Platform
LOG_LEVEL=INFO
DEPENDENCY_TIMEOUT_SECONDS=2
API_HOST=
API_PORT=
# Optional for public imports; private imports need Metadata/Issues read access.
GITHUB_TOKEN=
# Trusted HTTPS base URL; Enterprise may use https://HOST/api/v3.
GITHUB_API_URL=https://api.github.com
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# Must match the initial vector(1536) schema; resizing requires a new migration.
EMBEDDING_DIM=1536
# Optional database tests: temporary databases are created on this server.
# Supply a local PostgreSQL URL with CREATEDB/extension permissions to run them.
TEST_DATABASE_URL=
# Managed disposable checkouts; relative paths resolve from the worker working directory.
WORKSPACE_ROOT=workspaces
# Legacy unused placeholder retained for compatibility; use WORKSPACE_ROOT above.
REPOSITORY_WORKSPACE_ROOT=
SANDBOX_IMAGE=
SANDBOX_TIMEOUT_SECONDS=
SANDBOX_MEMORY_LIMIT=
SANDBOX_CPU_LIMIT=
MAX_RECOVERY_ATTEMPTS=
