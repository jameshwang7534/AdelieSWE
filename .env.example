# Local infrastructure defaults ONLY; never reuse this password in production.
# Compose reads these settings from .env or the shell; .env is ignored by Git.
POSTGRES_DB=platform_dev
POSTGRES_USER=platform_dev
POSTGRES_PASSWORD=local-development-only
# Published host ports; container ports remain 5432 and 6379.
POSTGRES_PORT=5432
REDIS_PORT=6379

# Application connection settings, consumed by Settings and readiness checks.
# Host processes use 127.0.0.1. Future Compose containers use postgres / redis.
# Keep URLs in sync with the credentials and host ports above; URL-encode
# special characters in usernames/passwords when constructing DATABASE_URL.
DATABASE_URL=postgresql+psycopg://platform_dev:local-development-only@127.0.0.1:5432/platform_dev
REDIS_URL=redis://127.0.0.1:6379/0
# Celery broker/results use separate Redis DBs; both are required for /tasks.
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# Application settings. Empty optional values use defaults or None.
APP_ENV=development
APP_NAME=AI Software Engineering Platform
LOG_LEVEL=INFO
DEPENDENCY_TIMEOUT_SECONDS=2
API_HOST=
API_PORT=
# Optional for public imports; private imports need Metadata/Issues read access.
GITHUB_TOKEN=
# Trusted HTTPS base URL; Enterprise may use https://HOST/api/v3.
GITHUB_API_URL=https://api.github.com
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
LLM_MAX_OUTPUT_TOKENS=2048
# Reject oversized review inputs rather than silently omitting changes or evidence.
REVIEW_MAX_INPUT_CHARS=200000
PLANNER_VALIDATION_RETRIES=2
ORCHESTRATION_RECOVERY_SECONDS=30
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# Must match the initial vector(1536) schema; resizing requires a new migration.
EMBEDDING_DIM=1536
# OpenAI-compatible embedding requests use LLM_API_KEY and LLM_BASE_URL.
# EMBEDDING_PROVIDER and EMBEDDING_API_KEY above are unused future placeholders.
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_RETRIES=3
EMBEDDING_TIMEOUT_SECONDS=30
# Disable for compatible providers that do not accept the dimensions parameter.
EMBEDDING_SEND_DIMENSIONS=true
# Optional database tests: temporary databases are created on this server.
# Supply a local PostgreSQL URL with CREATEDB/extension permissions to run them.
TEST_DATABASE_URL=
# Managed disposable checkouts; relative paths resolve from the worker working directory.
WORKSPACE_ROOT=workspaces
# Scanning and deterministic chunk limits; no embeddings are generated.
INDEX_MAX_FILE_BYTES=262144
INDEX_CHUNK_MAX_LINES=120
INDEX_CHUNK_MAX_CHARS=8000
# Issue-context output/query limits (characters, not model tokens).
CONTEXT_MAX_ISSUE_CHARS=12000
CONTEXT_MAX_CODE_CHARS=24000
CONTEXT_MAX_CHUNKS=12
CONTEXT_MAX_FILES=8
CONTEXT_MAX_QUERIES=3
CONTEXT_QUERY_CHARS=1000
CONTEXT_INCLUDE_NEIGHBORS=true
# Legacy unused placeholder retained for compatibility; use WORKSPACE_ROOT above.
REPOSITORY_WORKSPACE_ROOT=
# Operator-controlled aliases. Requests accept aliases only; pre-pull reviewed images.
SANDBOX_IMAGES={"python":"python:3.12-slim"}
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MEMORY_MB=256
SANDBOX_CPU_LIMIT=1
SANDBOX_PID_LIMIT=64
SANDBOX_OUTPUT_BYTES=1048576
SANDBOX_USER=1000:1000
# Exact command profiles enabled by the operator; repository config selects required profiles.
TEST_ALLOWED_COMMANDS=["pytest","python -m pytest","python -m unittest","npm test","npm run test","npm run lint","pnpm test","yarn test","go test","cargo test"]
MAX_RECOVERY_ATTEMPTS=3
